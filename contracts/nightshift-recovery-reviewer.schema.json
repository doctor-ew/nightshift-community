{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAIL",
        "SKIP"
      ]
    },
    "reason": {
      "type": "string"
    },
    "attempts": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "diff": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "branch",
        "diff",
        "model",
        "provider"
      ],
      "additionalProperties": false
    },
    "rules_fired": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "object",
      "properties": {
        "binding": {
          "type": "string"
        },
        "stage": {
          "type": "string",
          "enum": [
            "adoption",
            "review",
            "drift",
            "qa"
          ]
        },
        "reviewer_id": {
          "type": "string"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "reject"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "resolved",
                  "superseded",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "resolution",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "unverified", "pending_manual_acceptance"
                ]
              },
              "reason": {
                "type": "string"
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "status",
              "reason",
              "checks"
            ],
            "additionalProperties": false
          }
        },
        "ac_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "binding",
        "stage",
        "reviewer_id",
        "decision",
        "findings",
        "dispositions",
        "cases",
        "ac_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artifacts",
    "attempts",
    "reason",
    "results",
    "rules_fired",
    "status"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FAIL",
              "SKIP"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "minLength": 1
          }
        }
      }
    }
  ]
}
