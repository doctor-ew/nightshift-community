{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAIL",
        "SKIP"
      ]
    },
    "reason": {
      "type": "string"
    },
    "attempts": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "diff": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "branch",
        "diff",
        "model",
        "provider"
      ],
      "additionalProperties": false
    },
    "rules_fired": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "object",
      "properties": {
        "binding": {
          "type": "string"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "repair",
            "abstain"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "question": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "maxLength": 2000
            },
            "reason": {
              "type": "string",
              "maxLength": 4000
            },
            "options": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "description"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "question",
            "reason",
            "options"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "binding",
        "decision",
        "findings",
        "resolved",
        "coverage"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artifacts",
    "attempts",
    "reason",
    "results",
    "rules_fired",
    "status"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FAIL",
              "SKIP"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "minLength": 1
          }
        }
      }
    }
  ]
}
